APP_ENV=development
APP_NAME=talemotion-backend
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg://talemotion:development-password@localhost:5432/talemotion_dev
TEST_DATABASE_URL=postgresql+psycopg://talemotion:development-password@localhost:5432/talemotion_test
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

B2_REGION=
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=

GMI_API_KEY=
DASHSCOPE_API_KEY=
ALIBABA_API_KEY=
OPENAI_API_KEY=

TALEMOTION_STORYBOARD_PROVIDER=alibaba
TALEMOTION_STORYBOARD_MODEL=qwen-plus
TALEMOTION_STORYBOARD_MAX_ATTEMPTS=3
TALEMOTION_IMAGE_PROVIDER=gmicloud
TALEMOTION_IMAGE_MODEL=seedream-5.0-lite
TALEMOTION_VIDEO_PROVIDER=gmicloud
TALEMOTION_VIDEO_MODEL=wan2.6-i2v
TALEMOTION_VIDEO_DURATIONS=5
TALEMOTION_TTS_PROVIDER=gmicloud
TALEMOTION_TTS_MODEL=
TALEMOTION_TTS_VOICE=
TALEMOTION_MUSIC_PROVIDER=gmicloud
TALEMOTION_MUSIC_MODEL=
GENBLAZE_CACHE_DIR=.cache/genblaze
FFMPEG_BINARY=ffmpeg
FFMPEG_TIMEOUT_SECONDS=900
QUEUED_JOB_TIMEOUT_SECONDS=1800
RUNNING_JOB_TIMEOUT_SECONDS=7200

SESSION_COOKIE_NAME=talemotion_session
CSRF_COOKIE_NAME=talemotion_csrf
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false

NEW_USER_FREE_CREDITS=100
CREDIT_RATE_STORYBOARD_GENERATION=5
CREDIT_RATE_IMAGE_GENERATION=4
CREDIT_RATE_VIDEO_GENERATION=8
CREDIT_RATE_TTS_GENERATION=2
CREDIT_RATE_MUSIC_GENERATION=3
CREDIT_RATE_FINAL_RENDER=8
