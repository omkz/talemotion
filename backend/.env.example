APP_ENV=development
APP_NAME=talemotion-backend
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg://talemotion:talemotion@localhost:5432/talemotion
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND default to REDIS_URL.

# Required for real storyboard, image, and narration generation through Genblaze.
OPENAI_API_KEY=
GENBLAZE_TEXT_MODEL=gpt-4o-mini
GENBLAZE_IMAGE_MODEL=gpt-image-1
GENBLAZE_TTS_MODEL=gpt-4o-mini-tts
GENBLAZE_TTS_VOICE=alloy

# Required for generated assets, provenance manifests, and final renders.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=talemotion-media
B2_KEY_ID=
B2_APPLICATION_KEY=
SIGNED_URL_TTL_SECONDS=900

FFMPEG_PATH=ffmpeg
MEDIA_WORK_DIR=/tmp/talemotion-media
